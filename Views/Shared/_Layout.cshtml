@inject IConfiguration Configuration
@{
    // Group number and member names come from appsettings.json ("Team" section).
    var groupNumber = Configuration["Team:GroupNumber"] ?? "?";
    var members = Configuration.GetSection("Team:Members").Get<string[]>() ?? Array.Empty<string>();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dreams come True Tourism Agency</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom">
            <div class="container">
                <a class="navbar-brand brand-box" asp-controller="Home" asp-action="Index">Dreams come True</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active fw-bold" : "")"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Flights" ? "active fw-bold" : "")"
                               asp-controller="Flights" asp-action="Index">Flights</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Hotels" ? "active fw-bold" : "")"
                               asp-controller="Hotels" asp-action="Index">Hotels</a>
                        </li>
                    </ul>
                    <span class="navbar-text">Guest</span>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer border-top py-3 mt-auto">
        <div class="container text-center small text-muted">
            GBC_Travel-Group-@(groupNumber) &middot; @(string.Join(", ", members)) &middot; &copy; @(DateTime.Now.Year) Dreams come True Tourism Agency
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
