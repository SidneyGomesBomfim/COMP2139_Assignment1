@model Hotel

<div class="card result-card mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div class="thumb">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            }
            else
            {
                <span aria-hidden="true">🏨</span>
            }
        </div>

        <div class="flex-grow-1">
            <div class="fw-bold">@Model.Name</div>
            <div class="text-warning" title="@Model.StarRating-star">@Model.StarsText</div>
            <div class="text-muted small">@Model.Location · @Model.Address</div>
        </div>

        <div class="text-end">
            <div class="fs-4 fw-bold">@Model.PricePerNight.ToString("C0") <span class="fs-6 fw-normal text-muted">/ night</span></div>
            @if (Model.RoomsAvailable > 0)
            {
                <span class="badge text-bg-success mb-2">@Model.RoomsAvailable rooms available</span>
            }
            else
            {
                <span class="badge text-bg-secondary mb-2">No rooms available</span>
            }
            <div>
                <a class="btn btn-dark btn-sm" asp-controller="Hotels" asp-action="Details" asp-route-id="@Model.Id">View Details</a>
            </div>
        </div>
    </div>
</div>
