@model Flight

<div class="card result-card mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div class="thumb">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Airline" />
            }
            else
            {
                <span aria-hidden="true">✈</span>
            }
        </div>

        <div class="flex-grow-1 airline-col">
            <div class="fw-bold">@Model.Airline</div>
            <div class="text-muted small">@Model.FlightNumber</div>
        </div>

        <div class="flex-grow-1">
            <div class="fw-bold">@Model.DepartureTime.ToString("HH:mm") → @Model.ArrivalTime.ToString("HH:mm")</div>
            <div class="text-muted small">@Model.Origin → @Model.Destination · @Model.StopsText</div>
            <div class="text-muted small">@Model.DepartureTime.ToString("ddd, MMM d, yyyy")</div>
        </div>

        <div class="text-end">
            <div class="fs-4 fw-bold">@Model.Price.ToString("C0")</div>
            @if (Model.SeatsAvailable > 0)
            {
                <span class="badge text-bg-success mb-2">@Model.SeatsAvailable seats left</span>
            }
            else
            {
                <span class="badge text-bg-secondary mb-2">Sold out</span>
            }
            <div>
                <a class="btn btn-dark btn-sm" asp-controller="Flights" asp-action="Details" asp-route-id="@Model.Id">View Details</a>
            </div>
        </div>
    </div>
</div>
